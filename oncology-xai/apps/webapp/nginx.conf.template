# Plantilla de nginx para la webapp. La imagen oficial de nginx la procesa con envsubst al arrancar
# (/etc/nginx/templates -> /etc/nginx/conf.d). Solo se sustituyen variables de entorno definidas,
# así que las variables propias de nginx ($uri, etc.) quedan intactas.
#   CSP_S3_ORIGIN: origen del almacenamiento S3 al que el navegador sube y del que descarga (URL firmadas).
#   (release 0.3.2: Jobs del chart con nombre por hash, sin cambios funcionales aquí)
#   CSP_KEYCLOAK_ORIGIN: origen de un Keycloak externo (vacío si Keycloak va detrás del mismo dominio).
#   KEYCLOAK_URL / KEYCLOAK_REALM / KEYCLOAK_CLIENT_ID: configuración de login que la webapp lee en runtime
#   desde /runtime-config.js (vacío = mismo dominio / valores por defecto de la compilación). El chart los
#   rellena desde keycloak.external.url, keycloak.realm y keycloak.webClientId.

server {
    listen 3000;
    server_tokens off;
    root /usr/share/nginx/html;

    # Cabeceras de seguridad (se repiten en cada location porque add_header no se hereda si el location define alguna)
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_S3_ORIGIN}; connect-src 'self' ${CSP_S3_ORIGIN} ${CSP_KEYCLOAK_ORIGIN}; frame-src 'self' ${CSP_KEYCLOAK_ORIGIN}; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'";

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    # Configuración de login en runtime (la lee src/auth/keycloak.ts); sin caché para que un cambio de config aplique al reiniciar
    location = /runtime-config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 'window.__LCHAI__={keycloakUrl:"${KEYCLOAK_URL}",keycloakRealm:"${KEYCLOAK_REALM}",keycloakClientId:"${KEYCLOAK_CLIENT_ID}"};';
    }

    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri /index.html;
    }
}
